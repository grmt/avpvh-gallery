{
  "name": "avpvh-gallery",
  "version": "2.13.14.152",
  "description": "A WordPress gallery using Google Drive as file storage",
  "keywords": [
    "wordpress",
    "google",
    "drive",
    "gallery"
  ],
  "homepage": "https://github.com/grmt/avpvh-gallery",
  "bugs": {
    "url": "https://github.com/grmt/avpvh-gallery/issues"
  },
  "license": "MIT",
  "author": "grmt <admin@avphilipsvanhorne.nl>",
  "contributors": [
    "Marek Dědič (original author, Junák - český skaut)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grmt/avpvh-gallery.git"
  },
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob dist/*",
    "prebuild": "npm run clean",
    "build:gulp": "gulp --gulpfile config/gulpfile.js --cwd . --color build",
    "build:js:block": "FORCE_COLOR=1 vite build --config config/vite/block.config.ts",
    "build:js:camera-model-index": "FORCE_COLOR=1 vite build --config config/vite/camera-model-index.config.ts",
    "build:js:folder-authors": "FORCE_COLOR=1 vite build --config config/vite/folder-authors.config.ts",
    "build:js:tag-tree": "FORCE_COLOR=1 vite build --config config/vite/tag-tree.config.ts",
    "build:js:root_selection": "FORCE_COLOR=1 vite build --config config/vite/root_selection.config.ts",
    "build:js:shortcode": "FORCE_COLOR=1 vite build --config config/vite/shortcode.config.ts",
    "build:js:tinymce": "FORCE_COLOR=1 vite build --config config/vite/tinymce.config.ts",
    "build:js:exif-inspector": "FORCE_COLOR=1 vite build --config config/vite/exif-inspector.config.ts",
    "build:js": "run-p -c --aggregate-output build:js:*",
    "build": "run-p -c --aggregate-output build:*",
    "lint:css:stylelint": "stylelint --config config/stylelint.config.js --color 'src/**/*.css'",
    "lint:css": "run-p -c --aggregate-output lint:css:*",
    "lint:php:phan": "export PHAN_DISABLE_XDEBUG_WARN=1; vendor/bin/phan --allow-polyfill-parser --load-baseline=.phan/baseline.php",
    "lint:php:phpcs": "vendor/bin/phpcs --standard=config/phpcs.xml",
    "lint:php:phpmd": "vendor/bin/phpmd analyze --no-progress --format text --ruleset config/phpmd.xml src tests .phan/config.php config/scoper.inc.php",
    "lint:php:phpstan": "vendor/bin/phpstan --configuration=config/phpstan.neon",
    "lint:php": "run-p -c --aggregate-output lint:php:*",
    "lint:ts:eslint": "eslint --color 'src/**/*.ts' 'config/**/*.{js,ts}'",
    "lint:ts:fast": "oxlint src",
    "lint:ts:typecheck": "tsc --noEmit",
    "lint:ts": "run-p -c --aggregate-output lint:ts:*",
    "lint": "run-p -c --aggregate-output lint:*",
    "pretest:php:phpunit": "[ -e vendor/google ] && rm -r vendor/google; composer dump-autoload",
    "test:php:phpunit": "vendor/bin/phpunit --configuration config/phpunit.xml",
    "posttest:php:phpunit": "composer install",
    "test:php": "run-p -c --aggregate-output test:php:*",
    "test": "run-p -c --aggregate-output test:*",
    "plugin-check": "wp-env start && wp-env run cli wp plugin check avpvh-gallery --ignore-codes=missing_composer_json_file; CODE=$?; wp-env stop; exit $CODE",
    "i18n:pot": "find src/php -name '*.php' | sort | xargs xgettext --language=PHP --from-code=UTF-8 --add-comments=translators: --package-name=avpvh-gallery --no-wrap --add-location=file -k__ -k_e -kesc_html__ -kesc_html_e -kesc_attr__ -kesc_attr_e -k_x:1,2c -kesc_html_x:1,2c -kesc_attr_x:1,2c -k_n:1,2 -k_nx:1,2,4c -o src/languages/avpvh-gallery.pot && msgcat --use-first --no-wrap -o src/languages/avpvh-gallery.pot src/languages/avpvh-gallery.pot src/languages/plugin-header.pot",
    "i18n:po": "msgmerge --update --backup=none --no-wrap src/languages/avpvh-gallery-nl_NL.po src/languages/avpvh-gallery.pot",
    "i18n:mo": "msgfmt --check -o src/languages/avpvh-gallery-nl_NL.mo src/languages/avpvh-gallery-nl_NL.po",
    "i18n": "run-s i18n:pot i18n:po i18n:mo"
  },
  "engines": {
    "npm": "^11.0.0"
  },
  "dependencies": {
    "imagesloaded": "^5.0.0",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@types/imagesloaded": "^4.1.7",
    "@types/jquery": "^4.0.1",
    "@types/react": "^18.0.0 <19",
    "@types/wordpress__block-editor": "^15.0.9",
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/browserslist-config": "^7.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/editor": "^16.1.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/eslint-plugin": "^28.1.0",
    "@wordpress/stylelint-config": "^27.1.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "gulp": "^5.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.1.4",
    "gulp-shell": "^0.8.0",
    "jquery": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "rimraf": "^6.1.4",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "tinymce": "^8.10.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ]
}
